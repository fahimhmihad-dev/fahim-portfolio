# ============================================================================
# Fahim H. Mihad Portfolio — Environment Variables
# Copy this file to .env.local and populate your credentials. NEVER commit .env.local.
# ============================================================================

# Public site URL (used for canonical URLs, sitemap, robots, and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin lock (must also exist in public.admins table)
ADMIN_EMAIL=fahimhmihad@gmail.com

# Optional: Resend API key for contact email notifications & newsletter broadcasts
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: Analytics overrides (can also be configured in /admin/settings)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
